# =============================================================================
# ZITADEL Setup - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=zitadel
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=zitadel

# -----------------------------------------------------------------------------
# ZITADEL Configuration
# -----------------------------------------------------------------------------
# External domain - your auth server domain (e.g., auth.yourdomain.com)
# For local development: localhost
ZITADEL_EXTERNALDOMAIN=localhost

# Set to true for production (HTTPS), false for local development
ZITADEL_EXTERNALSECURE=false

# External port (443 for production with HTTPS, 8080 for local)
ZITADEL_EXTERNALPORT=8080

# Master encryption key (MUST be exactly 32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
ZITADEL_MASTERKEY=your-32-byte-master-key-here-base64

# Initial admin user (only used on first startup)
ZITADEL_ORG_NAME=YourCompany
ZITADEL_ADMIN_USERNAME=admin@yourdomain.com
ZITADEL_ADMIN_PASSWORD=YourSecurePassword123!

# Log level (debug, info, warn, error)
ZITADEL_LOG_LEVEL=info

# Port ZITADEL listens on locally
ZITADEL_PORT=8080

# -----------------------------------------------------------------------------
# Custom Login UI
# -----------------------------------------------------------------------------
# ZITADEL authority URL (the ZITADEL server URL)
ZITADEL_AUTHORITY=http://localhost:8080

# OIDC Client ID (create this in ZITADEL Console after first login)
ZITADEL_CLIENT_ID=

# Redirect URI after login (your login UI callback)
REDIRECT_URI=http://localhost:3000/callback

# Port for login UI
LOGIN_UI_PORT=3000

# -----------------------------------------------------------------------------
# Google SSO (Configure after ZITADEL is running)
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Railway Production Overrides
# -----------------------------------------------------------------------------
# When deploying to Railway, set these:
# ZITADEL_EXTERNALDOMAIN=your-app.railway.app
# ZITADEL_EXTERNALSECURE=true
# ZITADEL_EXTERNALPORT=443
# Railway provides DATABASE_URL automatically for PostgreSQL
